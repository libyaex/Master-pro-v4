# Master-pro-v4 — لا يحتوي أي مفاتيح إلزامية. البيانات العامة تعمل بدون أي شيء هنا.
# === التخزين ===
DB_BACKEND=sqlite            # sqlite (افتراضي) | postgres
DATABASE_URL=                # مثال postgresql+asyncpg://user:pass@host:5432/db (اختياري فقط)
# === التشغيل ===
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
TZ=UTC
# === مصادر البيانات (عامة، بلا مفاتيح) ===
EXCHANGES_ENABLED=binance_spot,binance_futures,bybit,okx,mexc
COINGECKO_ENABLED=false      # إثراء اختياري فقط
# === الوحدات المتقدمة (كل وحدة لها مفتاح تشغيل مستقل) ===
M1_ARBITRAGE_ENABLED=true
M2_WHALE_ENABLED=true
M3_LISTING_BREAKOUT_ENABLED=true
M5_ADAPTIVE_ENABLED=true
M6_RANKING_ENABLED=true
# === الأمان ===
SECRET_KEY=change-me-generate-random-64-hex
# === التداول الحقيقي (اختياري تماماً؛ يبقى مقفلاً حتى إتمام قائمة التحقق في الواجهة) ===
LIVE_TRADING_ENABLED=false
# مفاتيح المنصات (اختياري، فقط للتداول الورقي بالعمولات الحقيقية أو live/testnet)
# لا تطلب أبداً صلاحية سحب Withdrawals على أي مفتاح. النظام يحذر إن وجدها.
# BINANCE_KEY=
# BINANCE_SECRET=
# BYBIT_KEY=
# BYBIT_SECRET=
# OKX_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=
# MEXC_KEY=
# MEXC_SECRET=
